# Source code
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cxx text eol=lf
*.hxx text eol=lf

# Assembly
*.asm text eol=lf
*.s text eol=lf
*.S text eol=lf

# Linker scripts
*.ld text eol=lf
*.lds text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Build files
Makefile text eol=lf
*.mk text eol=lf
CMakeLists.txt text eol=lf

# Configuration
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf

# Binary files (no normalization)
*.bin binary
*.iso binary
*.o binary
*.a binary
*.so binary
*.dll binary
*.exe binary
*.elf binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.pdf binary

# IDE and editor files
.idea/ export-ignore
.vscode/ export-ignore
*.swp export-ignore
*.swo export-ignore
*~ export-ignore

# Build artifacts
build/ export-ignore
dist/ export-ignore
*.log export-ignore
